// Copilot
// 20251202-082639
contents=
/*
  Regatta Timer Test Framework - Updated Threshold 2.0V
  - Continuous horn voltage measurement on A0
  - Emits XML log message for each event where voltage exceeds 2.0 V
    The log contains:
      - elapsed: seconds since cycle start when the over-threshold event began
      - peakVoltage: peak voltage observed during that event (two decimals)
      - duration: seconds the voltage remained >2.0 V (three decimals)
  - Other behavior retained from the prior implementation:
    TM1637 display (CLK=3, DIO=5), simulated test buttons, automated cycle triggered by pin 6.
    Serial at 9600 baud, JUnit-like XML fragments.
*/

#include <Arduino.h>
#include <TM1637Display.h>

// Pins
const uint8_t TM1637_CLK = 3;
const uint8_t TM1637_DIO = 5;

const uint8_t BTN_CYCLE_PIN = 6; // input pullup to start auto cycle

const uint8_t BTN_1MIN = 2;  // simulated outputs
const uint8_t BTN_2MIN = 7;
const uint8_t BTN_3MIN = 8;
const uint8_t BTN_5MIN = 12;

const uint8_t VOLTAGE_PIN = A0;

// TM1637 display
TM1637Display display(TM1637_CLK, TM1637_DIO);
const uint8_t COLON_DOT = 0b01000000;

// Configuration
const int TEST_CYCLE_REPEAT = 10; // default repeat count
const unsigned long BUTTON_DEBOUNCE_DELAY = 200; // ms
const unsigned long VOLTAGE_LOG_INTERVAL = 1000; // ms sampling interval (1 Hz)
const float VOLTAGE_LOG_THRESHOLD = 2.0F; // volts (Vin threshold changed to 2.0V)

// Voltage divider constants (R1 connected to Vin, R2 to GND)
const float R1 = 10000.0;  // 10k
const float R2 = 5100.0;   // 5.1k

// Test sequences
const int testDurations[] = {60, 120, 180, 300};                // seconds
const uint8_t testPins[] = {BTN_1MIN, BTN_2MIN, BTN_3MIN, BTN_5MIN};
const int testSequenceNumbers[] = {1, 2, 3, 5};
const uint8_t NUM_TESTS = sizeof(testDurations) / sizeof(testDurations[0]);

// State variables
bool autoCycleRunning = false;
int autoCycleStep = 0; // 0..NUM_TESTS-1
bool autoCycleWaiting = false;
unsigned long autoCycleWaitUntil = 0;
int autoCycleTotalRepeats = TEST_CYCLE_REPEAT;
int autoCycleCurrentRepeat = 0;

bool testRunning = false;
unsigned long testStartMillis = 0;
unsigned long lastSecondUpdate = 0;
unsigned long lastVoltageLog = 0;
unsigned long cycleStartMillis = 0;
int currentTestDuration = 0;
int currentTestSequence = 0; // 1,2,3,5

// Voltage event tracking
bool voltageHigh = false;
unsigned long voltageHighStartMillis = 0;
float voltageHighPeak = 0.0F;

// Helper forward declarations
void startAutoCycle();
void startTest(int step);
void endTest();
void beginWaitPeriod();
void advanceOrEndCycle();
void logAutoCycleStart();
void logAutoCycleEnd();
void logTestStart(int sequence, int duration);
void logTestEnd(int sequence, unsigned long elapsedSeconds);
void logVoltageEvent(unsigned long elapsedStartSeconds, float peakVoltage, float durationSeconds);
float measureVin();
void updateDisplayForRemaining(int secondsRemaining);
void showMMSS(int minutes, int seconds);
void setAllSimPinsLow();

void setup() {
  Serial.begin(9600);
  while (!Serial) { ; } // wait for Serial if applicable

  // Init display
  display.setBrightness(0x0f); // maximum brightness
  display.showNumberDecEx(0, COLON_DOT, true, 4, 0); // show 00:00
  delay(20);

  // Configure pins
  pinMode(BTN_CYCLE_PIN, INPUT_PULLUP);

  pinMode(BTN_1MIN, OUTPUT);
  pinMode(BTN_2MIN, OUTPUT);
  pinMode(BTN_3MIN, OUTPUT);
  pinMode(BTN_5MIN, OUTPUT);
  setAllSimPinsLow();

  // Startup XML header
  Serial.println(F("<testsuite name=\"RegattaTimerTestFramework\">"));
  Serial.println(F("<properties>"));
  Serial.println(F("<property name=\"mode\" value=\"Automated Test Cycle Only\"/>"));
  Serial.println(F("</properties>"));
  Serial.println(F("<note>Regatta Timer Test Framework Ready</note>"));

  // Print ready message
  Serial.println(F("Regatta Timer Test Framework Ready"));

  // Initialize timers
  lastSecondUpdate = millis();
  lastVoltageLog = millis();
}

// main loop
void loop() {
  unsigned long now = millis();

  // Check start button (INPUT_PULLUP -> LOW when pressed)
  if (!autoCycleRunning && digitalRead(BTN_CYCLE_PIN) == LOW) {
    // debounce while still processing voltage sampling
    unsigned long pressMillis = now;
    while (millis() - pressMillis < BUTTON_DEBOUNCE_DELAY) {
      unsigned long tmpNow = millis();
      if (tmpNow - lastVoltageLog >= VOLTAGE_LOG_INTERVAL) {
        // sample voltage during debounce to remain responsive
        float v_tmp = measureVin();
        // manage voltage event state even during debounce
        if (v_tmp > VOLTAGE_LOG_THRESHOLD) {
          if (!voltageHigh) {
            voltageHigh = true;
            voltageHighStartMillis = tmpNow;
            voltageHighPeak = v_tmp;
          } else {
            if (v_tmp > voltageHighPeak) voltageHighPeak = v_tmp;
          }
        } else {
          if (voltageHigh) {
            unsigned long durationMs = tmpNow - voltageHighStartMillis;
            unsigned long elapsedStartSec = 0;
            if (autoCycleRunning) {
              elapsedStartSec = (voltageHighStartMillis - cycleStartMillis) / 1000UL;
            }
            float durationSec = durationMs / 1000.0F;
            logVoltageEvent(elapsedStartSec, voltageHighPeak, durationSec);
            voltageHigh = false;
            voltageHighPeak = 0.0F;
          }
        }
        lastVoltageLog = tmpNow;
      }
    }
    // confirm still pressed
    if (digitalRead(BTN_CYCLE_PIN) == LOW && !autoCycleRunning) {
      startAutoCycle();
    }
  }

  // Voltage sampling once per second (continuous)
  if (now - lastVoltageLog >= VOLTAGE_LOG_INTERVAL) {
    float v = measureVin();

    if (v > VOLTAGE_LOG_THRESHOLD) {
      if (!voltageHigh) {
        // voltage just went high
        voltageHigh = true;
        // Record the start time (relative to millis())
        voltageHighStartMillis = now;
        voltageHighPeak = v;
      } else {
        // already high - track peak
        if (v > voltageHighPeak) voltageHighPeak = v;
      }
    } else {
      if (voltageHigh) {
        // voltage fell below threshold - create event log
        unsigned long durationMs = now - voltageHighStartMillis;
        unsigned long elapsedStartSec = 0;
        if (autoCycleRunning) {
          // if cycle running: compute seconds since cycleStartMillis when event began
          if (voltageHighStartMillis >= cycleStartMillis) {
            elapsedStartSec = (voltageHighStartMillis - cycleStartMillis) / 1000UL;
          } else {
            // event began before cycle start - per spec elapsed=0
            elapsedStartSec = 0;
          }
        } else {
          // cycle not running -> elapsed 0
          elapsedStartSec = 0;
        }
        float durationSec = durationMs / 1000.0F;
        logVoltageEvent(elapsedStartSec, voltageHighPeak, durationSec);
        voltageHigh = false;
        voltageHighPeak = 0.0F;
      }
    }

    lastVoltageLog = now;
  }

  // Auto cycle state machine
  if (autoCycleRunning) {
    // If currently in a waiting gap between tests
    if (autoCycleWaiting) {
      if (now >= autoCycleWaitUntil) {
        autoCycleWaiting = false;
        // After wait, advance step or end cycle
        advanceOrEndCycle();
      }
    } else if (testRunning) {
      // Handle live test countdown and completion
      unsigned long elapsedTestSec = (now - testStartMillis) / 1000UL;
      if (now - lastSecondUpdate >= 1000UL) {
        lastSecondUpdate = now;
        int secondsRemaining = currentTestDuration - (int)elapsedTestSec;
        if (secondsRemaining < 0) secondsRemaining = 0;
        updateDisplayForRemaining(secondsRemaining);
      }
      if (elapsedTestSec >= (unsigned long)currentTestDuration) {
        endTest();
        // Begin 5-second wait after test completion (including after last)
        beginWaitPeriod();
      }
    } else {
      // Not waiting and not running a test -- normally handled in advanceOrEndCycle
    }
  } else {
    // Idle: ensure display shows 00:00 once per second
    if (now - lastSecondUpdate >= 1000UL) {
      lastSecondUpdate = now;
      display.showNumberDecEx(0, COLON_DOT, true, 4, 0); // 00:00
    }
  }
}

// Start the entire auto cycle
void startAutoCycle() {
  autoCycleRunning = true;
  autoCycleStep = 0;
  autoCycleWaiting = false;
  autoCycleCurrentRepeat = 0;
  cycleStartMillis = millis();

  logAutoCycleStart();

  // If voltage is currently above threshold at cycle start, treat the event as starting at cycle start
  float v_now = measureVin();
  if (v_now > VOLTAGE_LOG_THRESHOLD) {
    voltageHigh = true;
    voltageHighStartMillis = cycleStartMillis; // begin at cycle start for elapsed=0
    voltageHighPeak = v_now;
  }

  // Immediately start first test
  startTest(autoCycleStep);
}

// Start a test specified by step index (0..NUM_TESTS-1)
void startTest(int step) {
  if (step < 0 || step >= NUM_TESTS) return;

  currentTestDuration = testDurations[step];
  currentTestSequence = testSequenceNumbers[step];

  // Simulate button press by setting output HIGH for whole test duration
  uint8_t pin = testPins[step];
  digitalWrite(pin, HIGH);

  testRunning = true;
  testStartMillis = millis();
  lastSecondUpdate = millis();

  // Log test start
  logTestStart(currentTestSequence, currentTestDuration);

  // Update display immediately
  updateDisplayForRemaining(currentTestDuration);
}

// End current test (cleans up simulated button pin)
void endTest() {
  // Turn off simulated press pin
  for (uint8_t i = 0; i < NUM_TESTS; ++i) {
    if (testSequenceNumbers[i] == currentTestSequence) {
      digitalWrite(testPins[i], LOW);
      break;
    }
  }

  unsigned long elapsedSec = (millis() - testStartMillis) / 1000UL;
  if (elapsedSec > (unsigned long)currentTestDuration) elapsedSec = currentTestDuration;

  // Log test end
  logTestEnd(currentTestSequence, elapsedSec);

  testRunning = false;
}

// Begin a 5-second wait after a test
void beginWaitPeriod() {
  autoCycleWaiting = true;
  autoCycleWaitUntil = millis() + 5000UL;
  // Display 00:00 during the wait
  display.showNumberDecEx(0, COLON_DOT, true, 4, 0);
}

// Advance to next test step or handle cycle end/repeat
void advanceOrEndCycle() {
  autoCycleStep++;
  if (autoCycleStep < (int)NUM_TESTS) {
    // start next test
    startTest(autoCycleStep);
  } else {
    // Completed all steps in this cycle
    logAutoCycleEnd();

    autoCycleCurrentRepeat++;
    if (autoCycleCurrentRepeat < autoCycleTotalRepeats) {
      // Start next cycle repeat immediately
      autoCycleStep = 0;
      logAutoCycleStart();
      startTest(autoCycleStep);
    } else {
      // All repeats done - finish
      // If a voltage-high event is still in progress, close it now (log duration up until finish)
      unsigned long now = millis();
      if (voltageHigh) {
        unsigned long durationMs = now - voltageHighStartMillis;
        unsigned long elapsedStartSec = 0;
        if (voltageHighStartMillis >= cycleStartMillis) {
          elapsedStartSec = (voltageHighStartMillis - cycleStartMillis) / 1000UL;
        } else {
          elapsedStartSec = 0;
        }
        float durationSec = durationMs / 1000.0F;
        logVoltageEvent(elapsedStartSec, voltageHighPeak, durationSec);
        voltageHigh = false;
        voltageHighPeak = 0.0F;
      }

      autoCycleRunning = false;
      // Ensure all sim pins low
      setAllSimPinsLow();
      // After finishing, show 00:00
      display.showNumberDecEx(0, COLON_DOT, true, 4, 0);
      // Close testsuite tag for XML
      Serial.println(F("</testsuite>"));
    }
  }
}

// Logging helpers (emit JUnit-like XML fragments)

void logAutoCycleStart() {
  Serial.print(F("<testcase classname=\"AutoCycle\" type=\"Start\" elapsed=\"0\" repeat=\""));
  Serial.print(autoCycleCurrentRepeat + 1);
  Serial.print(F("\" totalRepeats=\""));
  Serial.print(autoCycleTotalRepeats);
  Serial.println(F("\"/>"));
}

void logAutoCycleEnd() {
  unsigned long elapsedCycleSeconds = 0;
  if (cycleStartMillis != 0) {
    elapsedCycleSeconds = (millis() - cycleStartMillis) / 1000UL;
  }
  Serial.print(F("<testcase classname=\"AutoCycle\" type=\"End\" elapsed=\""));
  Serial.print(elapsedCycleSeconds);
  Serial.print(F("\" repeatIndex=\""));
  Serial.print(autoCycleCurrentRepeat + 1);
  Serial.println(F("\"/>"));
}

void logTestStart(int sequence, int duration) {
  Serial.print(F("<testcase classname=\"TestStart\" testsequence=\""));
  Serial.print(sequence);
  Serial.print(F("\" elapsed=\"0\" type=\"Start\" duration=\""));
  Serial.print(duration);
  Serial.println(F("\"/>"));
}

void logTestEnd(int sequence, unsigned long elapsedSeconds) {
  Serial.print(F("<testcase classname=\"TestEnd\" testsequence=\""));
  Serial.print(sequence);
  Serial.print(F("\" elapsed=\""));
  Serial.print(elapsedSeconds);
  Serial.println(F("\" type=\"End\"/>"));
}

// Voltage event logging (elapsed = seconds since cycle start when event began)
// peakVoltage = maximum voltage measured during the event
// durationSeconds = seconds the voltage stayed > threshold
void logVoltageEvent(unsigned long elapsedStartSeconds, float peakVoltage, float durationSeconds) {
  Serial.print(F("<testcase classname=\"VoltageMonitor\" elapsed=\""));
  Serial.print(elapsedStartSeconds);
  Serial.print(F("\" peakVoltage=\""));
  Serial.print(peakVoltage, 2);
  Serial.print(F("\" duration=\""));
  Serial.print(durationSeconds, 3);
  Serial.println(F("\"/>"));
}

// Measure VIN using the specified divider and formula
float measureVin() {
  int raw = analogRead(VOLTAGE_PIN);
  float vout = (raw * 5.0F) / 1024.0F; // ADC reference assumed 5V
  float vin = vout * ((R1 + R2) / R2);
  return vin;
}

// Update the TM1637 display for the remaining seconds (MM:SS)
void updateDisplayForRemaining(int secondsRemaining) {
  if (secondsRemaining < 0) secondsRemaining = 0;
  int minutes = secondsRemaining / 60;
  int seconds = secondsRemaining % 60;
  showMMSS(minutes, seconds);
}

// Helper to show MM:SS on TM1637
void showMMSS(int minutes, int seconds) {
  int value = (minutes * 100) + seconds; // per spec: minutes * 100 + seconds
  display.showNumberDecEx(value, COLON_DOT, true, 4, 0);
}

// Ensure all simulated output pins are LOW
void setAllSimPinsLow() {
  digitalWrite(BTN_1MIN, LOW);
  digitalWrite(BTN_2MIN, LOW);
  digitalWrite(BTN_3MIN, LOW);
  digitalWrite(BTN_5MIN, LOW);
}
