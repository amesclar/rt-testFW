// 20251202-083639
#include <TM1637Display.h>

// Pin definitions
#define CLK 3
#define DIO 5
#define BTN_1MIN 2
#define BTN_2MIN 7
#define BTN_3MIN 8
#define BTN_5MIN 12
#define BTN_TEST_CYCLE 6
#define VOLTAGE_PIN A0

// Voltage divider resistors
#define R1 10000.0   // 10kΩ
#define R2 5100.0    // 5.1kΩ

// Test configuration
#define TEST_CYCLE_REPEAT 10
#define VOLTAGE_LOG_INTERVAL 1000
#define VOLTAGE_LOG_THRESHOLD 2.0

// Display object
TM1637Display display(CLK, DIO);

// Test timing state
bool testRunning = false;
unsigned long testStartMillis = 0;
unsigned long elapsedSeconds = 0;
unsigned long lastSecondUpdate = 0;
int currentTestSequence = 0;

// Automated test cycle state
bool autoCycleRunning = false;
int autoCycleStep = 0;           // 0=1min, 1=2min, 2=3min, 3=5min
int autoCycleRepeatCount = 0;    // Current repeat iteration
unsigned long autoCycleWaitUntil = 0;
bool autoCycleWaiting = false;

// Test sequence data
int testDurations[] = {60, 120, 180, 300};
int testPins[] = {BTN_1MIN, BTN_2MIN, BTN_3MIN, BTN_5MIN};
int testSequenceNumbers[] = {1, 2, 3, 5};

// Voltage measurement
unsigned long lastVoltageLog = 0;
bool voltageAboveThreshold = false;
unsigned long voltageHighStartTime = 0;
unsigned long voltageHighDuration = 0;
float voltagePeakValue = 0.0;

void setup() {
  Serial.begin(9600);

  // Initialize display
  display.setBrightness(0x0f);
  display.showNumberDecEx(0, 0b01000000, true);

  // Initialize pins
  pinMode(BTN_TEST_CYCLE, INPUT_PULLUP);
  pinMode(BTN_1MIN, OUTPUT);
  pinMode(BTN_2MIN, OUTPUT);
  pinMode(BTN_3MIN, OUTPUT);
  pinMode(BTN_5MIN, OUTPUT);
  pinMode(VOLTAGE_PIN, INPUT);

  // Set all output pins LOW
  digitalWrite(BTN_1MIN, LOW);
  digitalWrite(BTN_2MIN, LOW);
  digitalWrite(BTN_3MIN, LOW);
  digitalWrite(BTN_5MIN, LOW);

  Serial.println(F("Regatta Timer Test Framework Ready"));
}

void loop() {
  unsigned long currentMillis = millis();

  // Continuous voltage monitoring (non-blocking)
  monitorVoltage();

  // Check for test cycle button press (INPUT_PULLUP, so LOW = pressed)
  static bool testCyclePressed = false;
  if (digitalRead(BTN_TEST_CYCLE) == LOW && !testCyclePressed && !autoCycleRunning) {
    testCyclePressed = true;
    startAutoCycle();
    delay(200); // Debounce
  } else if (digitalRead(BTN_TEST_CYCLE) == HIGH) {
    testCyclePressed = false;
  }

  // Handle automated test cycle
  if (autoCycleRunning) {
    handleAutoCycle();
  }

  // Update test timer
  if (testRunning) {
    if (currentMillis - lastSecondUpdate >= 1000) {
      lastSecondUpdate = currentMillis;
      elapsedSeconds++;

      // Update display (countdown)
      int totalSeconds = testDurations[autoCycleStep];
      int remaining = totalSeconds - elapsedSeconds;
      if (remaining < 0) remaining = 0;
      int minutes = remaining / 60;
      int seconds = remaining % 60;
      display.showNumberDecEx(minutes * 100 + seconds, 0b01000000, true);

      // Check if test finished
      if (elapsedSeconds >= totalSeconds) {
        endTest();
      }
    }
  }
}

void startAutoCycle() {
  autoCycleRunning = true;
  autoCycleStep = 0;
  autoCycleRepeatCount = 0;
  autoCycleWaiting = false;

  Serial.println(F("<testcase classname=\"AutoCycleStart\" type=\"CycleStart\"/>"));

  // Trigger first test immediately
  simulateButtonPress(testPins[autoCycleStep]);
}

void handleAutoCycle() {
  unsigned long currentMillis = millis();

  // If waiting between tests
  if (autoCycleWaiting) {
    if (currentMillis >= autoCycleWaitUntil) {
      autoCycleWaiting = false;
      autoCycleStep++;

      // Check if all 4 tests in this cycle are complete
      if (autoCycleStep >= 4) {
        autoCycleRepeatCount++;

        // Check if all repeats are complete
        if (autoCycleRepeatCount >= TEST_CYCLE_REPEAT) {
          endAutoCycle();
        } else {
          // Start next repeat cycle
          autoCycleStep = 0;
          simulateButtonPress(testPins[autoCycleStep]);
        }
      } else {
        // Start next test in current cycle
        simulateButtonPress(testPins[autoCycleStep]);
      }
    }
  } else if (!testRunning && autoCycleRunning) {
    // Test just finished, start waiting period (5 seconds)
    autoCycleWaiting = true;
    autoCycleWaitUntil = millis() + 5000;
  }
}

void simulateButtonPress(int pin) {
  int sequence = testSequenceNumbers[autoCycleStep];
  int duration = testDurations[autoCycleStep];

  // Pulse output pin HIGH briefly to simulate button press
  digitalWrite(pin, HIGH);
  delay(200); // Hold for debounce period
  digitalWrite(pin, LOW);

  // Start test timing
  testRunning = true;
  elapsedSeconds = 0;
  testStartMillis = millis();
  lastSecondUpdate = testStartMillis;
  currentTestSequence = sequence;

  // Display initial time
  int minutes = duration / 60;
  int seconds = duration % 60;
  display.showNumberDecEx(minutes * 100 + seconds, 0b01000000, true);

  // Log test start
  Serial.print(F("<testcase classname=\"TestStart\" testsequence=\""));
  Serial.print(sequence);
  Serial.print(F("\" elapsed=\"0\" type=\"Start\" duration=\""));
  Serial.print(duration);
  Serial.println(F("\"/>"));
}

void endTest() {
  testRunning = false;

  // Log test end
  Serial.print(F("<testcase classname=\"TestEnd\" testsequence=\""));
  Serial.print(currentTestSequence);
  Serial.print(F("\" elapsed=\""));
  Serial.print(elapsedSeconds);
  Serial.println(F("\" type=\"End\"/>"));

  // Display 00:00
  display.showNumberDecEx(0, 0b01000000, true);
}

void endAutoCycle() {
  autoCycleRunning = false;

  Serial.println(F("<testcase classname=\"AutoCycleEnd\" type=\"CycleEnd\"/>"));

  // Display 00:00
  display.showNumberDecEx(0, 0b01000000, true);
}

float measureVoltage() {
  // Take multiple readings for accuracy
  int sum = 0;
  for (int i = 0; i < 10; i++) {
    sum += analogRead(VOLTAGE_PIN);
    delay(1);
  }
  int raw = sum / 10;

  // Convert to voltage
  float vout = (raw * 5.0) / 1024.0;
  float vin = vout * ((R1 + R2) / R2);

  return vin;
}

void monitorVoltage() {
  unsigned long currentMillis = millis();

  // Sample voltage every 100ms for continuous monitoring
  static unsigned long lastSample = 0;
  if (currentMillis - lastSample >= 100) {
    lastSample = currentMillis;

    float voltage = measureVoltage();

    // Check if voltage crosses threshold
    if (voltage > VOLTAGE_LOG_THRESHOLD && !voltageAboveThreshold) {
      // Voltage just went above threshold
      voltageAboveThreshold = true;
      voltageHighStartTime = currentMillis;
      voltagePeakValue = voltage; // Initialize peak
    } else if (voltage > VOLTAGE_LOG_THRESHOLD && voltageAboveThreshold) {
      // Voltage still above threshold - track peak
      if (voltage > voltagePeakValue) {
        voltagePeakValue = voltage;
      }
    } else if (voltage <= VOLTAGE_LOG_THRESHOLD && voltageAboveThreshold) {
      // Voltage just went below threshold - log the event
      voltageAboveThreshold = false;
      voltageHighDuration = currentMillis - voltageHighStartTime;

      Serial.print(F("<testcase classname=\"VoltageMonitor\" elapsed=\""));
      if (testRunning) {
        Serial.print(elapsedSeconds);
      } else {
        Serial.print(0);
      }
      Serial.print(F("\" peak_voltage=\""));
      Serial.print(voltagePeakValue, 2);
      Serial.print(F("\" duration=\""));
      Serial.print(voltageHighDuration);
      Serial.println(F("\"/>"));

      // Reset peak for next event
      voltagePeakValue = 0.0;
    }
  }
}
